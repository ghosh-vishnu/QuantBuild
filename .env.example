# Local proxy and server settings
API_TARGET=http://127.0.0.1:8000
DEV_HOST=127.0.0.1
DEV_PORT=5173
PREVIEW_HOST=127.0.0.1
PREVIEW_PORT=4173
# Public browser settings. Never place secrets in VITE_* variables.
# Blank origins use the current host with /api and /ws routes.
VITE_API_ORIGIN=
VITE_WS_ORIGIN=
VITE_LOCALE=en-IN
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=OpenStreetMap contributors
VITE_MAP_LINK_URL=https://www.openstreetmap.org/
E2E_BROWSER_CHANNEL=chrome
